*.bmp       binary
*.class     binary
*.doc       binary
*.docx      binary
*.eap       binary
*.eapx      binary
*.eot       binary
*.feap      binary
*.gif       binary
*.gpkg      binary
*.gz        binary
*.ico       binary
*.jar       binary
*.jpeg      binary
*.jpg       binary
*.otf       binary
*.pdf       binary
*.png       binary
*.ppt       binary
*.pptx      binary
*.qea       binary
*.qeax      binary
*.tar       binary
# Binary RDF (RDF/Thrift output)
*.trdf      binary
*.ttf       binary
