			<targetParameter name="sortedOutput" value="true" />
			<targetParameter name="generateNavigableRolesConfig" value="true" />
<!--			<targetParameter name="createCascadeRuleGraphImage" value="false"/>-->
			<targetParameter name="dbSchemaName" value="test" />
			
			<targetParameter name="appSchemaNameByTv" value="xmlns" />
			<targetParameter name="appSchemaVersionMajorMinorOnly" value="true" />
			<targetParameter name="generateInsertStatements" value="true" />
			
